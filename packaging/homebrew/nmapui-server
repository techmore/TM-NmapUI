#!/bin/bash
# Launch the NmapUI web service as the current (non-root) user.
# Installed by the Homebrew formula as `nmapui`; `brew services start nmapui`
# runs it as a per-user LaunchAgent. Environment variables override defaults.
set -euo pipefail

if [[ "$(id -u)" == 0 ]]; then
  echo "nmapui: refusing to run the web service as root. Privileged scans use the" >&2
  echo "validating helper instead: see 'nmapui-privileged-setup'." >&2
  exit 1
fi

APP_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd -P)"
VENV="${NMAPUI_VENV:-$APP_ROOT/venv}"
STATE="${NMAPUI_STATE_DIR:-$HOME/Library/Application Support/NmapUI-brew}"

export NMAPUI_DATA_DIR="${NMAPUI_DATA_DIR:-$STATE/data}"
export NMAPUI_LOG_DIR="${NMAPUI_LOG_DIR:-$STATE/logs}"
export NMAPUI_HOST="${NMAPUI_HOST:-127.0.0.1}"
export NMAPUI_PORT="${NMAPUI_PORT:-9000}"
# Never fall back to `sudo nmap`; only the validating helper may run as root.
export NMAPUI_REQUIRE_SCAN_HELPER="${NMAPUI_REQUIRE_SCAN_HELPER:-true}"
# No outbound lookups unless the operator opts in.
export NMAPUI_ENABLE_VULNERS="${NMAPUI_ENABLE_VULNERS:-false}"
export NMAPUI_ENABLE_UPDATE_CHECK="${NMAPUI_ENABLE_UPDATE_CHECK:-false}"
export NMAPUI_ENABLE_NETWORK_FINGERPRINT="${NMAPUI_ENABLE_NETWORK_FINGERPRINT:-false}"
export NMAPUI_SKIP_LEGACY_MIGRATION="${NMAPUI_SKIP_LEGACY_MIGRATION:-1}"
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$STATE/playwright-browsers}"
if [[ -z "${NMAPUI_PRIVILEGED_ASSETS:-}" && -d /usr/local/share/nmapui ]]; then
  export NMAPUI_PRIVILEGED_ASSETS=/usr/local/share/nmapui
fi

umask 077
mkdir -p "$NMAPUI_DATA_DIR" "$NMAPUI_LOG_DIR"

case "${1:-serve}" in
  serve)
    port="$NMAPUI_PORT"
    [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || { echo "Invalid NMAPUI_PORT: $port" >&2; exit 1; }
    bind_host="$NMAPUI_HOST"
    [[ "$bind_host" == *:* && "$bind_host" != \[*\] ]] && bind_host="[$bind_host]"
    cd "$APP_ROOT"
    exec "$VENV/bin/python" -m gunicorn \
      --bind "$bind_host:$port" \
      --workers 1 --threads 100 --timeout 180 --graceful-timeout 30 --no-control-socket \
      nmapui.wsgi:application
    ;;
  install-pdf-browser)
    # Optional: Chromium for PDF reports (~150 MB download from Playwright's CDN).
    exec "$VENV/bin/python" -m playwright install chromium
    ;;
  paths)
    echo "app:     $APP_ROOT"
    echo "data:    $NMAPUI_DATA_DIR"
    echo "logs:    $NMAPUI_LOG_DIR"
    echo "url:     http://$NMAPUI_HOST:$NMAPUI_PORT"
    ;;
  *)
    echo "usage: nmapui [serve|install-pdf-browser|paths]" >&2; exit 2 ;;
esac
