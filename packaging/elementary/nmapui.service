[Unit]
Description=TM-NmapUI scanner web UI (per-user, loopback only)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
Environment=NMAPUI_HOST=127.0.0.1
Environment=NMAPUI_PORT=9000
Environment=NMAPUI_DATA_DIR=%h/.local/share/nmapui
Environment=NMAPUI_LOG_DIR=%h/.local/share/nmapui/logs
Environment=NMAPUI_ENABLE_UPDATE_CHECK=false
Environment=NMAPUI_ALLOW_UNSAFE_WERKZEUG=true
ExecStart=@APP_DIR@/.venv/bin/python app.py
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=default.target
