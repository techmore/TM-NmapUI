[Desktop Entry]
Name=Network Scanner
Comment=Scan and monitor your networks with Nmap
Exec=nmapui-elementary
Icon=io.github.techmore.NmapUI
Terminal=false
Type=Application
Categories=Network;Security;
Keywords=nmap;scan;network;security;daedalus;
StartupWMClass=io.github.techmore.NmapUI
StartupNotify=true
Actions=QuickScan;Reports;History;Logs;

[Desktop Action QuickScan]
Name=Start Quick Scan
Exec=nmapui-elementary --quick-scan

[Desktop Action Reports]
Name=Reports
Exec=nmapui-elementary --tab reports

[Desktop Action History]
Name=Scan History
Exec=nmapui-elementary --tab history

[Desktop Action Logs]
Name=Logs
Exec=nmapui-elementary --tab logs
