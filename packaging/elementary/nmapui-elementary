#!/usr/bin/env python3
"""TM-NmapUI native window for elementary OS.

A thin GTK4 + WebKitGTK shell around the scanner's web UI, the same idea as the
macOS menu-bar app: the Flask UI is the product, this only gives it a dock icon,
a headerbar, single-instance behaviour and system light/dark.
"""
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("WebKit", "6.0")
from gi.repository import Adw, Gio, GLib, Gtk, WebKit  # noqa: E402

APP_ID = "io.github.techmore.NmapUI"
URL = os.environ.get("NMAPUI_URL", "http://127.0.0.1:9000/")
SERVICE = os.environ.get("NMAPUI_SERVICE", "nmapui.service")


def ensure_service():
    """Start the user service if it is installed and not running (best effort)."""
    try:
        state = subprocess.run(["systemctl", "--user", "is-active", SERVICE],
                               capture_output=True, text=True, timeout=5).stdout.strip()
        if state != "active":
            subprocess.run(["systemctl", "--user", "start", SERVICE], timeout=15, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Network Scanner", default_width=1280, default_height=860)
        self.web = WebKit.WebView()
        settings = self.web.get_settings()
        settings.set_property("enable-developer-extras", bool(os.environ.get("NMAPUI_DEVTOOLS")))
        # The native headerbar replaces the page's own title strip.
        self.web.get_user_content_manager().add_style_sheet(WebKit.UserStyleSheet(
            "html #scanner-header{display:none!important}"
            "html .mb-6.rounded-2xl.border.p-2{border-top:1px solid var(--e-headerbar-border)!important;border-radius:var(--e-radius)!important}"
            "html body{padding-top:12px!important}",
            WebKit.UserContentInjectedFrames.TOP_FRAME, WebKit.UserStyleLevel.USER, None, None))
        self.web.connect("load-failed", self.on_load_failed)
        self.web.connect("notify::title", self.on_title)
        self.web.connect("create", lambda *_: None)

        header = Adw.HeaderBar()
        self.title_widget = Adw.WindowTitle(title="Network Scanner", subtitle="")
        header.set_title_widget(self.title_widget)
        reload_button = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Reload")
        reload_button.connect("clicked", lambda *_: self.web.reload())
        header.pack_start(reload_button)

        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(self.web)
        self.set_content(view)
        self.web.load_uri(URL)

    def show_tab(self, name):
        if name.isalpha():
            self.web.evaluate_javascript(f"location.hash = '#{name}';", -1, None, None, None, None, None)

    def quick_scan(self):
        self.show_tab("dashboard")
        self.web.evaluate_javascript(
            "const b = document.getElementById('start-scan-btn'); if (b && !b.disabled) b.click();",
            -1, None, None, None, None, None)

    def on_title(self, *_):
        title = self.web.get_title() or "Network Scanner"
        self.title_widget.set_subtitle("" if title == "Network Scanner GUI" else title)

    def on_load_failed(self, _web, _event, uri, error):
        html = (f"<body style='font-family:Inter,system-ui,sans-serif;display:grid;place-items:center;height:90vh;"
                f"color:#667885'><div style='text-align:center'><h2>Scanner service is not running</h2>"
                f"<p>Could not reach {uri}<br>{GLib.markup_escape_text(error.message)}</p>"
                f"<p>Start it with <code>systemctl --user start {SERVICE}</code>, then reload.</p></div></body>")
        self.web.load_alternate_html(html, uri, None)
        return True


class App(Adw.Application):
    """Single instance; dock quicklist actions arrive as command lines in the running copy."""

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        ensure_service()

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        fresh = self.window is None
        if fresh:
            self.window = Window(self)
        self.window.present()
        pending = []
        if "--tab" in args and args.index("--tab") + 1 < len(args):
            pending.append(lambda: self.window.show_tab(args[args.index("--tab") + 1]))
        if "--quick-scan" in args:
            pending.append(self.window.quick_scan)
        # A fresh window needs its page loaded before scripts can touch it.
        delay = 2500 if fresh else 0
        for action in pending:
            GLib.timeout_add(delay, lambda a=action: (a(), False)[1])
        return 0


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
