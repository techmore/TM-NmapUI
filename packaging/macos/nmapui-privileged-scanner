#!/usr/bin/python3
"""Root-owned validating wrapper for privileged NmapUI scans.

The appliance needs root for SYN scans (`-sS`), OS detection (`-O`) and
`arp-scan`, but the web backend must not run as root. This wrapper is what
sudoers grants `NOPASSWD` for — never `nmap` directly — so a compromised backend
cannot ask root to execute arbitrary programs.

Everything the backend sends is re-validated here:

* the program must be `nmap` or `arp-scan`, resolved to a root-owned binary on a
  fixed search path (never the caller's `PATH`);
* exactly one scan technique from the allowlist;
* flags must come from the allowlist that covers the app's real invocations;
* `--script` and `--stylesheet` must resolve inside the root-owned asset
  directory, and scan output must resolve inside the data directory, so a
  writable checkout cannot smuggle executable Lua or write files as root;
* the target must look like an address/CIDR/hostname, never an option.

The helper is installed root:wheel 0755 and is deliberately standalone: it
imports nothing from the (possibly user-writable) project checkout.
"""

import os
import re
import shutil
import sys

ASSET_DIR = os.environ.get("NMAPUI_PRIVILEGED_ASSETS", "/usr/local/share/nmapui")
DATA_DIR = os.environ.get("NMAPUI_DATA_DIR", "/Library/Application Support/NmapUI/data")

# Only these locations are trusted to hold the scanner binaries.
TRUSTED_BIN_DIRS = ("/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin")

ALLOWED_PROGRAMS = ("nmap", "arp-scan")

NMAP_TECHNIQUES = ("-sS", "-sT", "-sn")
NMAP_BOOL_FLAGS = ("-A", "-Pn", "-sC", "-sV", "-O", "--open", "-n", "-F")
NMAP_TIMING_RE = re.compile(r"^-T[0-5]$")
NMAP_VALUE_FLAGS = ("--top-ports", "--max-parallelism", "--max-retries", "--min-rate", "--max-rate")
NMAP_EXCLUDE_FLAG = "--exclude"
NMAP_SCRIPT_FLAG = "--script"
NMAP_STYLESHEET_FLAG = "--stylesheet"
NMAP_OUTPUT_FLAGS = ("-oA", "-oX", "-oN", "-oG")
FORBIDDEN_FLAGS = ("--interactive", "-i", "--script-args-file", "--datadir", "--servicedb", "--versiondb")

TARGET_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/-]*$")
IFACE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
NUMBER_RE = re.compile(r"^[0-9]{1,6}$")


class Rejected(Exception):
    """Raised when a request is not on the allowlist."""


def _fail(message):
    sys.stderr.write("nmapui-privileged-scanner: refusing request: %s\n" % message)
    return 126


def _resolve_program(name):
    for directory in TRUSTED_BIN_DIRS:
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    raise Rejected("trusted binary not found for %r" % name)


def _validate_target(value):
    if not value or value.startswith("-"):
        raise Rejected("invalid target %r" % value)
    if ".." in value or not TARGET_RE.match(value):
        raise Rejected("invalid target %r" % value)
    return value


def _validate_exclude_list(value):
    if not value:
        raise Rejected("empty --exclude value")
    for item in value.split(","):
        _validate_target(item)
    return value


def _validate_contained_path(value, *, root, what):
    if not value:
        raise Rejected("empty path for %s" % what)
    resolved = os.path.realpath(value)
    root_real = os.path.realpath(root)
    if resolved != root_real and not resolved.startswith(root_real + os.sep):
        raise Rejected("%s must live under %s (got %s)" % (what, root_real, resolved))
    return resolved


def build_argv(request):
    """Validate a request list and return the argv to exec.

    ``request`` is the argv the backend would have handed to nmap/arp-scan,
    with no privilege prefix (for example ``nmap -sS -Pn ... 10.0.0.0/24``).
    """
    if not request:
        raise Rejected("empty request")

    program = os.path.basename(request[0])
    if program not in ALLOWED_PROGRAMS:
        raise Rejected("program %r is not allowed" % program)
    resolved_program = _resolve_program(program)

    args = list(request[1:])
    if not args:
        raise Rejected("no arguments supplied")

    for flag in args:
        if flag in FORBIDDEN_FLAGS:
            raise Rejected("flag %r is not allowed" % flag)

    if program == "nmap":
        # At most one technique: conflicting technique flags were the shape of an
        # earlier bug where a retry left both -sS and -sT on the command line.
        # Zero is allowed because nmap's own default is privileged-aware.
        techniques = [a for a in args if a in NMAP_TECHNIQUES]
        if len(techniques) > 1:
            raise Rejected(
                "at most one scan technique from %s is allowed" % (NMAP_TECHNIQUES,)
            )

    output = [resolved_program]
    index = 0
    positional = []
    while index < len(args):
        arg = args[index]

        if arg in NMAP_TECHNIQUES or arg in NMAP_BOOL_FLAGS or NMAP_TIMING_RE.match(arg):
            output.append(arg)
            index += 1
            continue

        if arg == NMAP_EXCLUDE_FLAG:
            if index + 1 >= len(args):
                raise Rejected("--exclude needs a value")
            output.extend([arg, _validate_exclude_list(args[index + 1])])
            index += 2
            continue

        if arg in (NMAP_SCRIPT_FLAG, NMAP_STYLESHEET_FLAG):
            if index + 1 >= len(args):
                raise Rejected("%s needs a value" % arg)
            output.extend([arg, _validate_contained_path(args[index + 1], root=ASSET_DIR, what=arg)])
            index += 2
            continue

        if arg in NMAP_OUTPUT_FLAGS:
            if index + 1 >= len(args):
                raise Rejected("%s needs a value" % arg)
            # The base name is supplied without extension by the caller.
            output.extend([arg, _validate_contained_path(args[index + 1], root=DATA_DIR, what=arg)])
            index += 2
            continue

        if arg in NMAP_VALUE_FLAGS:
            if index + 1 >= len(args):
                raise Rejected("%s needs a value" % arg)
            value = args[index + 1]
            if not NUMBER_RE.match(value):
                raise Rejected("%s needs a numeric value (got %r)" % (arg, value))
            output.extend([arg, value])
            index += 2
            continue

        if arg == "--interface":
            if index + 1 >= len(args):
                raise Rejected("--interface needs a value")
            interface = args[index + 1]
            if not IFACE_RE.match(interface):
                raise Rejected("invalid interface %r" % interface)
            output.extend([arg, interface])
            index += 2
            continue

        if arg.startswith("-"):
            raise Rejected("flag %r is not on the allowlist" % arg)

        positional.append(_validate_target(arg))
        index += 1

    if len(positional) != 1:
        raise Rejected("exactly one target is required (got %d)" % len(positional))

    output.extend(positional)
    return output


def main(argv):
    if os.geteuid() != 0:
        sys.stderr.write("nmapui-privileged-scanner: must run as root\n")
        return 126

    try:
        final_argv = build_argv(argv)
    except Rejected as exc:
        return _fail(str(exc))

    try:
        os.execv(final_argv[0], final_argv)
    except OSError as exc:
        sys.stderr.write("nmapui-privileged-scanner: exec failed: %s\n" % exc)
        return 126


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
